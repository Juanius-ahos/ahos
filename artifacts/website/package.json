{
  "name": "@workspace/website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "check:copy": "node scripts/check-copy.mjs",
    "build:client": "vite build --config vite.config.ts",
    "build:ssr": "vite build --config vite.config.ts --ssr src/entry-server.tsx --outDir dist-ssr",
    "prerender": "node scripts/prerender.mjs && node scripts/check-copy.mjs --dist",
    "build": "pnpm run check:copy && pnpm run build:client && pnpm run build:ssr && pnpm run prerender",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0 --port 4173",
    "og": "node scripts/og.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:preview": "pnpm run check:copy && vite build --config vite.config.ts --base=/ahos-preview/ && vite build --config vite.config.ts --base=/ahos-preview/ --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs --preview"
  },
  "dependencies": {
    "gsap": "^3.12.7",
    "lenis": "1.1.18",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "wouter": "^3.3.5"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "sharp": "^0.35.1",
    "vite": "^7.3.2"
  }
}
